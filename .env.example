# Application
APP_NAME="AI Stock Intelligence System"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Server
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Phase 2+ — Database (PostgreSQL / Supabase)
# Uncomment and populate when Phase 2 is implemented.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockdb
# POSTGRES_USER=stockuser
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=stockdb

# ---------------------------------------------------------------------------
# Phase 3+ — Data Providers
# Add provider API keys here. Never commit actual keys.
# ---------------------------------------------------------------------------
# MARKET_DATA_PROVIDER=dev_yfinance
# ALPHA_VANTAGE_API_KEY=your_key_here
# NEWS_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Phase 11+ — Redis (event bus / cache)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Phase 6+ — LLM (optional, for explanation narration)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your_key_here
# LLM_PROVIDER=openai
